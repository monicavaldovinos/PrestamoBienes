<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="utez.edu.mx.proyectointegrador.controller.ProfesoresController"
            stylesheets="@estilos.css">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER" spacing="10" styleClass="header">
            <Label text="Profesores" styleClass="header-label"/>
        </HBox>

    </top>

    <!-- MENÚ LATERAL -->
    <left>
        <VBox spacing="10" styleClass="sidebar" alignment="TOP_CENTER" prefWidth="180">
            <Button text="Profesores" styleClass="sidebar-button"/>
            <Button text="Préstamos" styleClass="sidebar-button"/>
            <Button text="Devoluciones" styleClass="sidebar-button"/>
            <Button text="Historial" styleClass="sidebar-button"/>
            <Button text="Configuración" styleClass="sidebar-button"/>
            <Button text="Cerrar sesión" styleClass="sidebar-button"/>
        </VBox>
    </left>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="15" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_RIGHT" prefWidth="600">
            <Button fx:id="btnAgregarProfesor" text="Agregar Profesor" styleClass="add-button"/>

        </HBox>
            <TableView fx:id="tablaProfesores" maxWidth="950" prefWidth="650" VBox.vgrow="ALWAYS" >

                 <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                    <TableColumn fx:id="colDivision" text="División" prefWidth="200"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>

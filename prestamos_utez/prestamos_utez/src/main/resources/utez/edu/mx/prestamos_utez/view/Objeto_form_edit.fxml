<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<GridPane fx:id="formPane" alignment="CENTER" hgap="10" prefHeight="400" prefWidth="600" style="-fx-background-color: white;" vgap="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utez.edu.mx.prestamos_utez.controller.ObjetoFormController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>
        <!-- Título -->
        <Label prefHeight="27.0" prefWidth="452.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Editar Objeto" GridPane.columnSpan="2" GridPane.halignment="CENTER" />

        <!-- Nombre -->
        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtNombre" prefHeight="31.0" prefWidth="291.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <!-- Número de inventario -->
        <Label text="Número de inventario:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="txtInventario" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Número de serie -->
        <Label text="Número de serie:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtSerie" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Descripción -->
        <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- URL de la imagen -->
        <Label text="URL de la imagen:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="txtImagen" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <!-- Cantidad -->
        <Label text="Cantidad:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="txtCantidad" GridPane.columnIndex="1" GridPane.rowIndex="6" />

        <!-- División -->
        <Label text="División:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <ComboBox fx:id="cbDivision" prefHeight="31.0" prefWidth="306.0" promptText="Selecciona una división" GridPane.columnIndex="1" GridPane.rowIndex="7" />

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="8">
            <children>
                <Button fx:id="btnCancelar" onAction="#onCancelar" style="-fx-background-color: #969CA3; -fx-text-fill: white;" text="Cancelar" />
                <Button onAction="#onGuardar" style="-fx-background-color: #1e88e5; -fx-text-fill: white;" text="Guardar" />
            </children>
        </HBox>
    </children>

    <!-- Columnas y filas -->
    <columnConstraints>
        <ColumnConstraints />
        <ColumnConstraints />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>

</GridPane>

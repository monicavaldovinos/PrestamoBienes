<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxWidth="900.0" prefHeight="600.0" prefWidth="790.0" style="-fx-background-color: white;" stylesheets="@../css/profesor_list.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utez.edu.mx.prestamos_utez.controller.ProfesorListController">

    <top>
        <BorderPane style="-fx-background-color: #009688; -fx-padding: 10;">
            <left>
                <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="REBUP" />
            </left>
            <center>
                <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="PROFESORES" />
            </center>
        </BorderPane>
    </top>

    <left>
        <VBox alignment="TOP_LEFT" prefWidth="200" spacing="20" style="-fx-background-color: #0B3D91; -fx-padding: 30;">
            <children>
                <Button text="Profesores" styleClass="sidebar-button"/>
                <Button text="Objetos" styleClass="sidebar-button"/>
                <Button text="Historial" styleClass="sidebar-button"/>
                <Button text="Cerrar sesión" styleClass="sidebar-button" onAction="#onCerrarSesion"/>

            </children>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30;">
            <children>
                <HBox alignment="TOP_RIGHT">
                   <children>
                       <Button fx:id="btnAgregarProfesor" prefHeight="40" prefWidth="180" style="-fx-background-color: #0B3D91; -fx-text-fill: white; -fx-font-weight: bold;" text="AGREGAR PROFESOR" />
                   </children>
                </HBox>

                <TableView fx:id="tablaProfesores" prefHeight="600.0" prefWidth="600">
                    <columns>
                        <TableColumn fx:id="colNo" text="No." prefWidth="50" />
                        <TableColumn fx:id="colNombre" prefWidth="200" text="NOMBRE" />
                        <TableColumn fx:id="colApellidos" prefWidth="200" text="APELLIDOS" />
                        <TableColumn fx:id="colDivision" prefWidth="200" text="DIVISIÓN" />
                        <TableColumn fx:id="colAcciones" prefWidth="180" text="ACCIONES" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

</BorderPane>

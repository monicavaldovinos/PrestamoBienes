<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="utez.edu.mx.prestamos_utez.controller.ProfesorListController">

    <children>

        <BorderPane>

            <!-- Barra superior con botón a la derecha -->
            <top>
                <HBox spacing="8" style="-fx-padding: 12;">
                    <children>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAgregarProfesor"
                                text="AGREGAR PROFESOR"
                                prefHeight="40" prefWidth="180"
                                style="-fx-background-color:#0B3D91; -fx-text-fill:white; -fx-font-weight:bold;"/>
                    </children>
                </HBox>
            </top>

            <!-- Contenido centrado con padding (márgenes) -->
            <center>
                <VBox style="-fx-padding: 24;" fillWidth="true">
                    <children>

                        <TableView fx:id="tablaProfesores"
                                   VBox.vgrow="ALWAYS"
                                   tableMenuButtonVisible="false">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>
                                <TableColumn fx:id="colNo" text="No."
                                             minWidth="70" prefWidth="70" maxWidth="70"/>

                                <!-- Esta se expande para llenar el espacio sobrante -->
                                <TableColumn fx:id="colNombre" text="Nombre"/>

                                <TableColumn fx:id="colApellidos" text="Apellidos"
                                             minWidth="240" prefWidth="240" maxWidth="240"/>

                                <TableColumn fx:id="colDivision" text="División"
                                             minWidth="160" prefWidth="160" maxWidth="160"/>

                                <TableColumn fx:id="colAcciones" text="Acciones"
                                             minWidth="110" prefWidth="110" maxWidth="110"
                                             sortable="false" resizable="false"
                                             style="-fx-alignment: CENTER;"/>
                            </columns>
                        </TableView>

                    </children>
                </VBox>
            </center>

        </BorderPane>

    </children>
</StackPane>
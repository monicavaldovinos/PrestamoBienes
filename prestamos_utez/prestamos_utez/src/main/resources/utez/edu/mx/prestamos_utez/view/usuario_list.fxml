<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="805.0" prefWidth="1327.0" spacing="20.0" style="-fx-padding:16;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utez.edu.mx.prestamos_utez.controller.UsuarioListController">
   <children>
   
       <HBox spacing="8">
      <children>
              <Label style="-fx-font-size:18; -fx-font-weight:bold;" />
              <Pane HBox.hgrow="ALWAYS" />
              <Button onAction="#nuevo" prefHeight="38.0" prefWidth="220.0" style="-fx-background-color: #0B3D91;" text="Agregar usuario" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Button>
      </children>
       </HBox>
   
       <TableView fx:id="tabla" prefHeight="654.0" prefWidth="1295.0">
           <columns>
               <TableColumn fx:id="colId" prefWidth="61.0" text="#" />
               <TableColumn fx:id="colNombre" prefWidth="206.0" text="Nombre" />
               <TableColumn fx:id="colApellidos" prefWidth="242.0" text="Apellidos" />
               <TableColumn fx:id="colCorreo" prefWidth="252.0" text="Correo" />
               <TableColumn fx:id="colRol" prefWidth="210.0" text="Rol" />
               <TableColumn fx:id="colDivision" prefWidth="187.0" text="División" />
               <TableColumn fx:id="colAcciones" prefWidth="136.0" text="Acciones" />
           </columns>
       </TableView>
   </children>
</VBox>

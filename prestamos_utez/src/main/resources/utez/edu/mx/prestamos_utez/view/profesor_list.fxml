<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utez.edu.mx.prestamos_utez.controller.ProfesorListController">

    <children>

        <BorderPane>

            <!-- Barra superior con botón a la derecha -->
            <top>
                <HBox style="-fx-padding: 12;">
                    <children>
                        <Region prefHeight="40.0" prefWidth="800.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnAgregarProfesor" prefHeight="40" prefWidth="180.0" style="-fx-background-color:#0B3D91; -fx-text-fill:white; -fx-font-weight:bold;" text="AGREGAR PROFESOR">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin></Button>
                    </children>
                </HBox>
            </top>

            <!-- Contenido centrado con padding (márgenes) -->
            <center>
                <VBox fillWidth="true" style="-fx-padding: 24;">
                    <children>

                        <TableView fx:id="tablaProfesores" prefHeight="400.0" prefWidth="1280.0" tableMenuButtonVisible="false" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>

                            <columns>
                                <TableColumn fx:id="colNo" maxWidth="80.0" minWidth="72.0" prefWidth="70" text="No." />

                                <!-- Esta se expande para llenar el espacio sobrante -->
                                <TableColumn fx:id="colNombre" maxWidth="323.0" minWidth="230.0" prefWidth="323.0" text="Nombre" />

                                <TableColumn fx:id="colApellidos" maxWidth="343.0" minWidth="250.0" prefWidth="343.0" text="Apellidos" />

                                <TableColumn fx:id="colDivision" maxWidth="379.0" minWidth="235.0" prefWidth="378.0" text="División" />
                                <TableColumn fx:id="colArea" text="Área" minWidth="200.0" prefWidth="240.0"/>


                                <TableColumn fx:id="colAcciones" maxWidth="329.0" minWidth="205.0" prefWidth="283.0" resizable="false" sortable="false" style="-fx-alignment: CENTER;" text="Acciones" />
                            </columns>
                        </TableView>

                    </children>
                </VBox>
            </center>

        </BorderPane>

    </children>
</StackPane>

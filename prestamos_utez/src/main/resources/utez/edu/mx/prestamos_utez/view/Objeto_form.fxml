<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane fx:id="formPane" hgap="12" prefHeight="560" prefWidth="768.0" vgap="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="utez.edu.mx.prestamos_utez.controller.ObjetoFormController">

    <padding>
        <Insets bottom="18" left="20" right="20" top="18" />
    </padding>

    <children>
        <!-- Título -->
        <Label style="-fx-font-size:18; -fx-font-weight:bold;" text="Objeto" GridPane.columnSpan="2" GridPane.halignment="CENTER" />

        <!-- Nombre -->
        <Label text="Nombre:" GridPane.rowIndex="1" />
        <TextField fx:id="txtNombre" prefHeight="31" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <!-- Descripción -->
        <Label text="Descripción:" GridPane.rowIndex="2" />
        <TextField fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- URL imagen -->
        <Label text="URL imagen:" GridPane.rowIndex="3" />
        <TextField fx:id="txtImagen" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- División -->
        <Label text="División:" GridPane.rowIndex="4" />
        <ComboBox fx:id="cbDivision" prefHeight="31" prefWidth="557.0" promptText="Selecciona una división" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Cantidad -->
        <Label text="Cantidad:" GridPane.rowIndex="5" />
        <TextField fx:id="txtCantidad" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <!-- Distribución por áreas (modo 'lote') -->
        <Label text="Distribuir por áreas:" GridPane.rowIndex="6" />
        <VBox fx:id="boxDistribucionWrapper" managed="true" spacing="8" visible="true" GridPane.columnIndex="1" GridPane.rowIndex="6">
            <children>
                <HBox spacing="10" />
                <VBox fx:id="boxFilasAreas" spacing="6" />
                <HBox spacing="10">
                    <children>
                        <Button fx:id="btnAgregarFilaArea" text="+ Agregar área" />
                        <Pane HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Toggle por unidad -->
        <Label text="Ingresar número de serie/inventario" GridPane.rowIndex="7" />
        <CheckBox fx:id="chkCapturarUnidades" GridPane.columnIndex="1" GridPane.rowIndex="7" />

        <!-- Ítems por unidad -->
        <Label GridPane.rowIndex="8" />
        <ScrollPane fx:id="spUnidades" fitToWidth="true" managed="false" prefHeight="220" visible="false" GridPane.columnIndex="1" GridPane.rowIndex="8">
            <content>
                <VBox fx:id="boxUnidades" spacing="6" />
            </content>
        </ScrollPane>

        <!-- Botones -->
        <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="9">
            <children>
                <Button fx:id="btnCancelar" prefHeight="35" prefWidth="100" style="-fx-background-color:#969CA3; -fx-text-fill:white;" text="Cancelar">
                    <font><Font name="System Bold" size="15" /></font>
                </Button>
                <Button onAction="#onGuardar" prefHeight="35" prefWidth="100" style="-fx-background-color:#1e88e5; -fx-text-fill:white;" text="Guardar">
                    <font><Font name="System Bold" size="15" /></font>
                </Button>
            </children>
        </HBox>
    </children>

    <columnConstraints>
        <ColumnConstraints maxWidth="215.0" minWidth="198.0" prefWidth="201.0" />
        <ColumnConstraints hgrow="ALWAYS" maxWidth="700.0" minWidth="520.0" prefWidth="635.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints />  <!-- título -->
        <RowConstraints />  <!-- nombre -->
        <RowConstraints />  <!-- descripción -->
        <RowConstraints />  <!-- url imagen -->
        <RowConstraints />  <!-- división -->
        <RowConstraints />  <!-- cantidad -->
        <RowConstraints />  <!-- distribuir por áreas -->
        <RowConstraints />  <!-- toggle -->
        <RowConstraints vgrow="ALWAYS" /> <!-- ítems por unidad -->
        <RowConstraints />  <!-- botones -->
    </rowConstraints>
</GridPane>

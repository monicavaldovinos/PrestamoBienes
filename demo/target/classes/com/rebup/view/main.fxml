<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/18"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.rebup.ui.controller.MainController">

    <left>
        <VBox styleClass="side-bar" spacing="40" alignment="TOP_LEFT" prefWidth="180">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="REBUP" styleClass="side-bar-title" />

            <VBox spacing="20" prefWidth="160">
                <Button fx:id="btnPrestamos" text="Préstamos" styleClass="side-bar-button" alignment="CENTER_LEFT" />
                <Button fx:id="btnDevoluciones" text="Devoluciones" styleClass="side-bar-button" alignment="CENTER_LEFT" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" prefHeight="60" spacing="10">
            <padding>
                <Insets top="0" right="30" bottom="0" left="30"/>
            </padding>
            <ImageView fx:id="logo" fitHeight="100" fitWidth="100" preserveRatio="true" pickOnBounds="true" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="PRESTAMOS" styleClass="top-bar-title" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <center>
        <VBox spacing="10" alignment="TOP_CENTER" prefWidth="800" prefHeight="600">
            <padding>
                <Insets top="20" right="40" bottom="40" left="40"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT" prefWidth="600">
                <ComboBox fx:id="cbProfesor" editable="true" promptText="Profesor" prefWidth="300" />
                <Pane HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="comboFiltro" prefWidth="150" />
            </HBox>

           
            <VBox fx:id="contadoresBox" spacing="5" alignment="TOP_CENTER" />

        
            <Label fx:id="lblContador" text="Llevas 0 objetos" styleClass="contador-label" />

           
            <GridPane fx:id="gridEquipos" hgap="40" vgap="40" alignment="CENTER" />

            
            <Button fx:id="btnConfirmar" text="Confirmar préstamo" maxWidth="220" styleClass="btn-confirmar" />
        </VBox>
    </center>

</BorderPane>
